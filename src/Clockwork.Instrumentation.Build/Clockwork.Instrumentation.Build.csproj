<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>MSBuild task package that applies Clockwork's deterministic IL instrumentation to a project's resolved output as an opt-in, out-of-place build step. Set ClockworkInstrumentationEnabled=true to activate. Requires the .NET 10 SDK (dotnet build / dotnet msbuild); the task and its Mono.Cecil-based engine target net10.0 and are not loadable by .NET Framework MSBuild. See docs/compatibility.md.</Description>
    <RootNamespace>Clockwork.Instrumentation.Build</RootNamespace>

    <!-- This is a build-time task package: ship the task assembly and its dependencies under
         tasks/, the props/targets under build/, and advertise no runtime dependencies. -->
    <IsPackable>true</IsPackable>
    <PackageId>Clockwork.Instrumentation.Build</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ReubenBond/Clockwork</RepositoryUrl>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSBuild assemblies are provided by the host; reference them for compile only. -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="Runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="Runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine and its transitive assemblies are shipped in tasks/, not as package deps. -->
    <ProjectReference Include="..\Clockwork.Instrumentation\Clockwork.Instrumentation.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\Clockwork.Instrumentation.Build.props" Pack="true" PackagePath="build\" />
    <None Include="build\Clockwork.Instrumentation.Build.targets" Pack="true" PackagePath="build\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Pack the task assembly and every runtime dependency (engine, runtime, Mono.Cecil) into
       tasks/net10.0/ so the targets can load them with a single UsingTask AssemblyFile. -->
  <Target Name="PackClockworkTaskAssemblies" BeforeTargets="_GetPackageFiles" DependsOnTargets="Build">
    <ItemGroup>
      <None Include="$(TargetPath)" Pack="true" PackagePath="tasks/$(TargetFramework)/" />
      <None Include="@(ReferenceCopyLocalPaths)"
            Condition="'%(Extension)' == '.dll'"
            Pack="true"
            PackagePath="tasks/$(TargetFramework)/" />
    </ItemGroup>
  </Target>

</Project>
