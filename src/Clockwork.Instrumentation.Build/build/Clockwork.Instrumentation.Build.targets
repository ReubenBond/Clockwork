<Project>

  <!--
    Clockwork.Instrumentation.Build - targets.

    Loads the ClockworkInstrumentTask from tasks/net10.0 and runs it out-of-place after Build,
    but only when ClockworkInstrumentationEnabled=true. Requires the .NET 10 SDK: the task
    assembly and its Mono.Cecil-based engine target net10.0 and cannot be loaded by .NET
    Framework MSBuild (Visual Studio's classic msbuild.exe). Use `dotnet build`/`dotnet msbuild`.
  -->

  <UsingTask TaskName="Clockwork.Instrumentation.Build.ClockworkInstrumentTask"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\net10.0\Clockwork.Instrumentation.Build.dll" />
  <UsingTask TaskName="Clockwork.Instrumentation.Build.ClockworkValidateInstrumentedTestTask"
             AssemblyFile="$(MSBuildThisFileDirectory)..\tasks\net10.0\Clockwork.Instrumentation.Build.dll" />

  <PropertyGroup>
    <!-- A simulation test project always instruments, but rule-set selection remains explicit. -->
    <ClockworkInstrumentationEnabled Condition="'$(ClockworkInstrumentedTestProject)' == 'true' and '$(TargetFramework)' != ''">true</ClockworkInstrumentationEnabled>

    <!-- The resolved application output directory to instrument (defaults to this project's output). -->
    <ClockworkUninstrumentedTestDirectory Condition="'$(ClockworkUninstrumentedTestDirectory)' == ''">$(IntermediateOutputPath)clockwork\source\</ClockworkUninstrumentedTestDirectory>
    <ClockworkUninstrumentedTestDirectoryFullPath>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(ClockworkUninstrumentedTestDirectory)))</ClockworkUninstrumentedTestDirectoryFullPath>
    <ClockworkSourceDirectory Condition="'$(ClockworkSourceDirectory)' == '' and '$(ClockworkInstrumentedTestProject)' == 'true' and '$(TargetFramework)' != ''">$(ClockworkUninstrumentedTestDirectoryFullPath)</ClockworkSourceDirectory>
    <ClockworkSourceDirectory Condition="'$(ClockworkSourceDirectory)' == ''">$(TargetDir)</ClockworkSourceDirectory>
    <ClockworkEntryAssemblyName Condition="'$(ClockworkEntryAssemblyName)' == ''">$(TargetName)</ClockworkEntryAssemblyName>

    <!--
      Out-of-place staging and manifest defaults. These are defined here (not in the .props file)
      because they depend on $(IntermediateOutputPath), which the SDK only computes after package
      .props are imported. Both remain overridable by the consuming project.
    -->
    <!-- Out-of-place staging under obj; the task fully owns and recreates this directory. -->
    <ClockworkStagingDirectory Condition="'$(ClockworkStagingDirectory)' == ''">$(IntermediateOutputPath)clockwork\instrumented\</ClockworkStagingDirectory>
    <ClockworkStagingDirectoryFullPath>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(ClockworkStagingDirectory)))</ClockworkStagingDirectoryFullPath>
    <ClockworkStagedTargetPath>$([MSBuild]::NormalizePath($(ClockworkStagingDirectoryFullPath), $(TargetFileName)))</ClockworkStagedTargetPath>

    <!-- Manifest lives outside the staged closure so it never ships with the app. -->
    <ClockworkManifestPath Condition="'$(ClockworkManifestPath)' == ''">$(IntermediateOutputPath)clockwork\clockwork.manifest.json</ClockworkManifestPath>

    <!-- Written atomically only after the entire closure has been instrumented successfully. -->
    <ClockworkSuccessPath Condition="'$(ClockworkSuccessPath)' == ''">$(IntermediateOutputPath)clockwork\clockwork.$(ClockworkInstrumentationMode).success</ClockworkSuccessPath>
    <ClockworkModeStampPath Condition="'$(ClockworkModeStampPath)' == ''">$(IntermediateOutputPath)clockwork\clockwork.mode</ClockworkModeStampPath>

    <!-- Auto-discover a project-adjacent config file when the consumer has not set one. -->
    <ClockworkConfigurationPath Condition="'$(ClockworkConfigurationPath)' == '' and Exists('$(MSBuildProjectDirectory)\clockwork.config.json')">$(MSBuildProjectDirectory)\clockwork.config.json</ClockworkConfigurationPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(ClockworkInstrumentedTestProject)' == 'true'">
    <!-- The runner executes before a simulation exists. Keep test-host implementation outside the
         simulated closure while rewriting the test assembly and every application dependency. -->
    <ClockworkExclude Include="Microsoft.Testing%2A.dll" />
    <ClockworkExclude Include="Microsoft.TestPlatform%2A.dll" />
    <ClockworkExclude Include="Microsoft.ApplicationInsights.dll" />
    <ClockworkExclude Include="Microsoft.Bcl.AsyncInterfaces.dll" />
    <ClockworkExclude Include="xunit%2A.dll" />
    <ClockworkExclude Include="nunit%2A.dll" />
    <ClockworkExclude Include="MSTest%2A.dll" />
    <ClockworkExclude Include="TUnit%2A.dll" />
    <ClockworkExclude Include="testhost.dll" />
  </ItemGroup>

  <Target Name="ClockworkValidateInstrumentedTestConfiguration"
          BeforeTargets="PrepareForBuild"
          Condition="'$(ClockworkInstrumentedTestProject)' == 'true' and '$(TargetFramework)' != ''">
    <Error Condition="'$(OutputType)' != 'Exe'"
           Text="Clockwork instrumented test projects must be executable test applications (OutputType=Exe)." />
    <Error Condition="'@(ClockworkRuleSet)' == '' and '@(ClockworkBuiltInRuleSet)' == '' and '$(ClockworkConfigurationPath)' == ''"
           Text="Clockwork instrumented test projects must select at least one @(ClockworkRuleSet) or @(ClockworkBuiltInRuleSet)." />
  </Target>

  <!-- A previous successful simulation build leaves rewritten files in bin. Restore its pristine
       snapshot before the next build so incremental compilation and mode changes start from normal IL. -->
  <Target Name="ClockworkRestoreUninstrumentedTestClosure"
          BeforeTargets="PrepareForBuild"
          Condition="'$(ClockworkInstrumentedTestProject)' == 'true' and '$(TargetFramework)' != '' and Exists('$(ClockworkUninstrumentedTestDirectoryFullPath)')">
    <ItemGroup>
      <_ClockworkPristineFile Include="$(ClockworkUninstrumentedTestDirectoryFullPath)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)" />
    <Copy SourceFiles="@(_ClockworkPristineFile)"
          DestinationFiles="@(_ClockworkPristineFile->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Snapshot the complete ordinary test output before rewriting it out of place. -->
  <Target Name="ClockworkCaptureUninstrumentedTestClosure"
          AfterTargets="Build"
          BeforeTargets="ClockworkInstrument"
          Condition="'$(ClockworkInstrumentedTestProject)' == 'true' and '$(TargetFramework)' != ''">
    <ItemGroup>
      <_ClockworkOrdinaryTestFile Include="$(TargetDir)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(ClockworkUninstrumentedTestDirectoryFullPath)" />
    <MakeDir Directories="$(ClockworkUninstrumentedTestDirectoryFullPath)" />
    <Copy SourceFiles="@(_ClockworkOrdinaryTestFile)"
          DestinationFiles="@(_ClockworkOrdinaryTestFile->'$(ClockworkUninstrumentedTestDirectoryFullPath)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="ClockworkWriteInstrumentationModeStamp"
          BeforeTargets="ClockworkInstrument"
          Condition="'$(ClockworkInstrumentationEnabled)' == 'true'">
    <ReadLinesFromFile File="$(ClockworkModeStampPath)"
                       Condition="Exists('$(ClockworkModeStampPath)')">
      <Output TaskParameter="Lines" PropertyName="ClockworkPreviousInstrumentationMode" />
    </ReadLinesFromFile>
    <Delete Files="$(ClockworkSuccessPath);$(ClockworkManifestPath)"
            Condition="'$(ClockworkPreviousInstrumentationMode)' != '' and '$(ClockworkPreviousInstrumentationMode)' != '$(ClockworkInstrumentationMode)'" />
    <WriteLinesToFile File="$(ClockworkModeStampPath)"
                      Lines="$(ClockworkInstrumentationMode)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Always invoke the task when enabled; its content-hash cache validates the complete staged closure. -->
  <Target Name="ClockworkInstrument"
          AfterTargets="Build"
          Condition="'$(ClockworkInstrumentationEnabled)' == 'true'">

    <Message Importance="high" Text="Clockwork: instrumenting '$(ClockworkSourceDirectory)' -> '$(ClockworkStagingDirectory)'" />

    <ClockworkInstrumentTask
        SourceDirectory="$(ClockworkSourceDirectory)"
        StagingDirectory="$(ClockworkStagingDirectory)"
        ConfigurationPath="$(ClockworkConfigurationPath)"
        RuleSetPaths="@(ClockworkRuleSet)"
        BuiltInRuleSets="@(ClockworkBuiltInRuleSet)"
        BuiltInIncludeFamilies="@(ClockworkBuiltInInclude)"
        BuiltInExcludeFamilies="@(ClockworkBuiltInExclude)"
        IncludePatterns="@(ClockworkInclude)"
        ExcludePatterns="@(ClockworkExclude)"
        InstrumentationMode="$(ClockworkInstrumentationMode)"
        TargetRuntime="$(ClockworkTargetRuntime)"
        EntryAssemblyName="$(ClockworkEntryAssemblyName)"
        ManifestPath="$(ClockworkManifestPath)"
        CachePath="$(ClockworkSuccessPath)">
      <Output TaskParameter="ResolvedManifestPath" PropertyName="ClockworkResolvedManifestPath" />
      <Output TaskParameter="WasIncremental" PropertyName="ClockworkWasIncremental" />
    </ClockworkInstrumentTask>

    <Message Importance="normal" Text="Clockwork: manifest at '$(ClockworkResolvedManifestPath)' (incremental: $(ClockworkWasIncremental))" />
  </Target>

  <Target Name="ClockworkValidateInstrumentedTestOutput"
          AfterTargets="ClockworkInstrument"
          Condition="'$(ClockworkInstrumentedTestProject)' == 'true' and '$(TargetFramework)' != ''">
    <Error Condition="!Exists('$(ClockworkSuccessPath)')"
           Text="Clockwork instrumented test output is incomplete: success marker '$(ClockworkSuccessPath)' was not found. Build without --no-build first." />
    <Error Condition="!Exists('$(ClockworkManifestPath)')"
           Text="Clockwork instrumented test output is incomplete: manifest '$(ClockworkManifestPath)' was not found. Build without --no-build first." />
    <Error Condition="!Exists('$(ClockworkStagedTargetPath)')"
           Text="Clockwork staged test entry assembly '$(ClockworkStagedTargetPath)' was not found. Build without --no-build first." />

    <ClockworkValidateInstrumentedTestTask
        StagingDirectory="$(ClockworkStagingDirectoryFullPath)"
        ManifestPath="$(ClockworkManifestPath)"
        EntryAssemblyName="$(TargetFileName)" />
  </Target>

  <!-- Deploy only into this simulation project's test-output copy. Production project outputs and
       every non-opted-in test project remain ordinary IL, including no-build test executions. -->
  <Target Name="ClockworkDeployInstrumentedTestClosure"
          AfterTargets="ClockworkInstrument"
          DependsOnTargets="ClockworkValidateInstrumentedTestOutput"
          Condition="'$(ClockworkInstrumentedTestProject)' == 'true' and '$(TargetFramework)' != ''">
    <ItemGroup>
      <_ClockworkInstrumentedTestFile Include="$(ClockworkStagingDirectoryFullPath)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)" />
    <MakeDir Directories="$(TargetDir)" />
    <Copy SourceFiles="@(_ClockworkInstrumentedTestFile)"
          DestinationFiles="@(_ClockworkInstrumentedTestFile->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high"
             Text="Clockwork: deployed the instrumented simulation test closure to '$(TargetDir)'." />
  </Target>

</Project>
