<Project>

  <!--
    Clockwork.Instrumentation.Build - default properties (imported early).

    Instrumentation is strictly opt-in. Ordinary builds do nothing unless a consumer sets
    ClockworkInstrumentationEnabled=true. All paths below are overridable by the consuming project.
  -->

  <PropertyGroup>
    <!-- Master opt-in switch. Never instrument unless this is explicitly true. -->
    <ClockworkInstrumentationEnabled Condition="'$(ClockworkInstrumentationEnabled)' == ''">false</ClockworkInstrumentationEnabled>
    <ClockworkInstrumentationMode Condition="'$(ClockworkInstrumentationMode)' == ''">Controlled</ClockworkInstrumentationMode>

    <!--
      Built-in deterministic BCL rule set. Set ClockworkUseBuiltInRules=true to enable the shipped
      deterministic clock/identity/random/crypto rules without authoring JSON.
    -->
    <ClockworkUseBuiltInRules Condition="'$(ClockworkUseBuiltInRules)' == ''">false</ClockworkUseBuiltInRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- When ClockworkUseBuiltInRules is on, enable the first production deterministic BCL rule set. -->
    <ClockworkBuiltInRuleSet Condition="'$(ClockworkUseBuiltInRules)' == 'true'" Include="clockwork.bcl.deterministic" />
  </ItemGroup>

  <!--
    NOTE: The out-of-place staging and manifest paths are intentionally NOT defaulted here.
    They depend on $(IntermediateOutputPath), which the SDK computes after package .props are
    imported. Defaulting them here would bake in an empty prefix (writing to the project root).
    They are defaulted in the accompanying .targets file, which is imported after the SDK props.
  -->

</Project>
