<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The Clockwork command-line tool for deterministic IL instrumentation, explicit scenario recording, exact replay, bounded schedule exploration, trace minimization, and diagnostics. Requires the .NET 10 runtime.</Description>
    <RootNamespace>Clockwork.Tool</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>dotnet-clockwork</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-clockwork</ToolCommandName>
    <PackageId>Clockwork.Tool</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ReubenBond/Clockwork</RepositoryUrl>
    <PackageTags>deterministic;testing;replay;schedule-exploration;instrumentation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clockwork.Instrumentation\Clockwork.Instrumentation.csproj" />
    <ProjectReference Include="..\Clockwork\Clockwork.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Clockwork.Instrumentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
