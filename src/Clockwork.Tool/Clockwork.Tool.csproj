<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The Clockwork command-line tool (clockwork). Provides 'rewrite' to apply deterministic IL instrumentation to an application closure and 'inspect' to report the managed/ReadyToRun/strong-name/symbol/idempotence state of assemblies. Packaged as a .NET global/local tool. Requires the .NET 10 runtime.</Description>
    <RootNamespace>Clockwork.Tool</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>clockwork</AssemblyName>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clockwork</ToolCommandName>
    <PackageId>Clockwork.Tool</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ReubenBond/Clockwork</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clockwork.Instrumentation\Clockwork.Instrumentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Clockwork.Instrumentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
