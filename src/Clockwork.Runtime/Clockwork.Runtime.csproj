<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Deterministic instrumentation runtime plumbing: ambient execution context, secure simulation activation, seed/decision domains, decision-log/replay contracts, and API policy classification. The deterministic simulation kernel itself (clock, task queue, scheduler, network, node lifecycle) still lives in src/Clockwork/Clockwork.csproj (packaged as Clockwork.Simulation) until it migrates here in a later phase; this project has no dependencies so the kernel can depend on it without any circularity.</Description>
    <RootNamespace>Clockwork.Runtime</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
