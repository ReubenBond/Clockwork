<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A deterministic simulation testing framework for distributed systems.</Description>
    <RootNamespace>Clockwork</RootNamespace>
    <PackageId>Clockwork.Simulation</PackageId>
    <Version>0.1.0</Version>
    <PackageTags>simulation;testing;distributed-systems;deterministic;chaos-testing;time-travel</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ReubenBond/Clockwork</RepositoryUrl>
    <!-- SupportedRuntimesMarker reads a loaded assembly's metadata in place. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- CW1004 holds every completion in this assembly to SimulationCompletion. -->
    <ProjectReference Include="..\Clockwork.Analyzers\Clockwork.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
