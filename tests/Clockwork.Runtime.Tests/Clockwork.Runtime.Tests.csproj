<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orleans.Testing.Simulation\Orleans.Testing.Simulation.csproj">
      <RepositorySourceRole>SimulationKernel</RepositorySourceRole>
    </ProjectReference>
  </ItemGroup>

  <Target Name="EmbedSimulationKernelProjectPath" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_SimulationKernelProjectReference
          Include="@(ProjectReference)"
          Condition="'%(RepositorySourceRole)' == 'SimulationKernel'" />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SimulationKernelProjectPath</_Parameter1>
        <_Parameter2>@(_SimulationKernelProjectReference->'%(FullPath)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
    <Error Condition="'@(_SimulationKernelProjectReference)' == ''"
           Text="The simulation kernel ProjectReference must have RepositorySourceRole=SimulationKernel." />
  </Target>
</Project>
