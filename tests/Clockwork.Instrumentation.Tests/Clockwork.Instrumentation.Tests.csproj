<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Seed the isolated package-smoke feed so trim/AOT/single-file analyzer fixtures restore offline. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" PrivateAssets="all" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orleans.Testing.Simulation.Instrumentation\Orleans.Testing.Simulation.Instrumentation.csproj" />
    <ProjectReference Include="..\..\src\Orleans.Testing.Simulation.Tool\Orleans.Testing.Simulation.Tool.csproj" />
  </ItemGroup>

  <!-- The rule-set completeness test enumerates the reference pack this project compiles against. -->
  <Target Name="EmbedReferencePackDirectory" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_ClockworkSystemRuntimeReference Include="@(ReferencePath)" Condition="'%(Filename)%(Extension)' == 'System.Runtime.dll' and '%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>ReferencePackDirectory</_Parameter1>
        <_Parameter2>@(_ClockworkSystemRuntimeReference->'%(RootDir)%(Directory)')</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
